<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>io.github.aliir74.shot-prompt</string>
	<key>ProgramArguments</key>
	<array><string>__APP__/Contents/MacOS/ShotPrompt</string></array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SHOT_PROMPT_CWD</key><string>__CWD__</string>
		<key>SHOT_PROMPT_DISPATCH</key><string>__DISPATCH__</string>
	</dict>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ProcessType</key><string>Interactive</string>
	<key>StandardErrorPath</key><string>/tmp/shot-prompt.log</string>
</dict>
</plist>
